#include <iostream>
#include <vector>
using namespace std;
class Bulanan {
public:
    int bulan;
    int uangSaku;
    int pengeluaran;
    int tabungan;
    Bulanan(int b, int saku, int keluar) {
        bulan = b;
        uangSaku = saku;
        pengeluaran = keluar;
        tabungan = saku - keluar;
    }
    void tampilkan() {
        cout << "Bulan " << bulan << ":\n";
        cout << "  Uang Saku     : " << uangSaku << "\n";
        cout << "  Pengeluaran   : " << pengeluaran << "\n";
        cout << "  Tabungan      : " << tabungan << "\n";
        cout << "-------------------------\n";
    }
};
class Keuangan {
private:
    vector<Bulanan> data;
public:
    void tambahData(int bulan, int saku, int keluar) {
        data.push_back(Bulanan(bulan, saku, keluar));
    }
    void tampilkanDataIteratif() {
        cout << "\n--- Data Keuangan Andi ---\n";
        for (int i = 0; i < data.size(); i++) {
            data[i].tampilkan();
        }
    }
    int totalPengeluaran() {
        int total = 0;
        for (int i = 0; i < data.size(); i++) {
    total += data[i].pengeluaran;
        }
        return total;
    }
    int totalTabunganRekursif(int i) {
        if (i < 0) return 0;
        return data[i].tabungan + totalTabunganRekursif(i - 1);
    }

    void tampilkanRingkasan() {
        cout << "\n--- Ringkasan ---\n";
        cout << "Total Pengeluaran : " << totalPengeluaran() << "\n";
        cout << "Total Tabungan    : " << totalTabunganRekursif(data.size() - 1) << "\n";
    }
};
int main() {
    Keuangan andi;
    int bulan, saku, keluar, jumlahBulan;
    cout << "Masukkan jumlah bulan: ";
    cin >> jumlahBulan;
    for (int i = 1; i <= jumlahBulan; i++) {
        cout << "\nBulan ke-" << i << ":\n";
        cout << "Uang saku       : ";
        cin >> saku;
        cout << "Total pengeluaran: ";
        cin >> keluar;

        andi.tambahData(i, saku, keluar);
    }
    andi.tampilkanDataIteratif();
    andi.tampilkanRingkasan();
    return 0;
}
